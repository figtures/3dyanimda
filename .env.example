# Values from the NEW shared Supabase project only.
# Leave empty for a local, read-only design preview.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public interface: industrial (1), editorial (2), studio (3).
# Vite injects these at BUILD time. Restart dev / rebuild and redeploy after changes.
VITE_SITE_THEME=studio
# Optional per-brand overrides. Empty = VITE_SITE_THEME.
VITE_THEME_3DYANIMDA=
VITE_THEME_3DSANAYI=
VITE_THEME_MAKETYANIMDA=
VITE_THEME_PARCAYANIMDA=
# Optional, public per-site settings. Configure separately for each brand build.
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
# Server/build only. Ownership file is emitted into the public production export.
INDEXNOW_KEY=
